{
  "manifest_version": 3,
  "name": "Ambient Light for Anything (Spotify, YouTube Music, YouTube)",
  "version": "1.2.0",
  "description": "Universal dynamic hardware-accelerated ambient lighting and Liquid Glass for Spotify, YouTube Music, and YouTube.",
  "author": "Antigravity Engineering",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Ambient Light Settings",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://open.spotify.com/*",
    "https://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://open.spotify.com/*",
        "https://*.youtube.com/*"
      ],
      "css": [
        "src/styles/ambient.css",
        "src/styles/ytmusic.css",
        "src/styles/spotify.css"
      ],
      "js": [
        "src/engine/presets.js",
        "src/engine/bar-detection.js",
        "src/engine/ambient-engine.js",
        "src/ui/settings-controller.js",
        "src/ui/in-page-menu.js",
        "src/adapters/ytmusic-adapter.js",
        "src/adapters/spotify-adapter.js",
        "src/adapters/youtube-adapter.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/styles/ambient.css",
        "src/styles/ytmusic.css",
        "src/styles/spotify.css",
        "icons/*"
      ],
      "matches": [
        "https://music.youtube.com/*",
        "https://open.spotify.com/*",
        "https://*.youtube.com/*"
      ]
    }
  ]
}
